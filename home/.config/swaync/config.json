{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "left",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 0,
  "control-center-margin-left": 8,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": 310,
  "control-center-height": 600,
  "notification-window-width": 310,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "script-fail-notify": true,
  "scripts": {},
  "notification-visibility": {},
  "widgets": [
    "title",
    "notifications",
    "volume",
    "backlight",
    "buttons-grid"
  ],
  "widget-config": {
    "title": {
      "text": "Notification Center",
      "clear-all-button": true,
      "button-text": ""
    },
    "notifications": {
      "vexpand": true
    },
    "volume": {
      "label": "",
      "show-per-app": true
    },
    "backlight": {
      "label": "",
      "device": "amdgpu_bl1",
      "min": 1
    },
    "buttons-grid": {
      "buttons-per-row": 5,
      "actions": [
        {
          "label": "󰝟",
          "command": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
        },
        {
          "label": "",
          "command": "pactl set-source-mute @DEFAULT_SOURCE@ toggle"
        },
        {
          "label": "",
          "command": "kitty --title Wi-Fi iwctl"
        },
        {
          "label": "",
          "command": "kitty --title Bluetooth bluetoothctl"
        },
        {
          "label": "",
          "command": "swaync-client -d"
        },
        {
          "label": "",
          "command": "swaync-client -cp; hyprshot -m region -o ~/Pictures/Screenshots"
        },
        {
          "label": "",
          "command": "dolphin"
        },
        {
          "label": "",
          "command": "swaync-client -cp; wofi --show drun"
        },
        {
          "label": "",
          "command": "kitty htop"
        },
        {
          "label": "",
          "command": "swaync-client -cp; hyprlock"
        }
      ]
    }
  }
}
